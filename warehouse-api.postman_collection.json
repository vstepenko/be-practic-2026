{
	"info": {
		"_postman_id": "warehouse-api-collection",
		"name": "Warehouse API",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "baseUrl",
			"value": "http://localhost:8080",
			"type": "string"
		},
		{
			"key": "itemId",
			"value": "",
			"type": "string"
		}
	],
	"item": [
		{
			"name": "Hello World",
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{baseUrl}}/api/hello-world",
					"host": ["{{baseUrl}}"],
					"path": ["api", "hello-world"]
				}
			}
		},
		{
			"name": "Get All Items",
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{baseUrl}}/api/warehouse",
					"host": ["{{baseUrl}}"],
					"path": ["api", "warehouse"]
				}
			}
		},
		{
			"name": "Add Item",
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"itemName\": \"Sample Widget\",\n  \"description\": \"A useful sample widget\",\n  \"icon\": \"https://example.com/icon.png\",\n  \"attributes\": \"{\\\"color\\\": \\\"blue\\\"}\"\n}"
				},
				"url": {
					"raw": "{{baseUrl}}/api/item",
					"host": ["{{baseUrl}}"],
					"path": ["api", "item"]
				}
			}
		},
		{
			"name": "Update Item",
			"request": {
				"method": "PUT",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"itemName\": \"Updated Widget\",\n  \"description\": \"An updated widget\",\n  \"icon\": \"https://example.com/updated-icon.png\",\n  \"attributes\": \"{\\\"color\\\": \\\"red\\\"}\"\n}"
				},
				"url": {
					"raw": "{{baseUrl}}/api/item/{{itemId}}",
					"host": ["{{baseUrl}}"],
					"path": ["api", "item", "{{itemId}}"]
				}
			}
		},
		{
			"name": "Delete Item",
			"request": {
				"method": "DELETE",
				"header": [],
				"url": {
					"raw": "{{baseUrl}}/api/item/{{itemId}}",
					"host": ["{{baseUrl}}"],
					"path": ["api", "item", "{{itemId}}"]
				}
			}
		}
	]
}
