<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.6.xsd">

    <changeSet id="create_category_table" author="Yevhenii Androsov">
        <createTable tableName="category">
            <column name="id" type="varchar">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="name" type="varchar"/>
            <column name="description" type="varchar"/>
        </createTable>
    </changeSet>

    <changeSet id="add_category_id_to_catalog" author="Yevhenii Androsov">
        <addColumn tableName="catalog">
            <column name="category_id" type="varchar"/>
        </addColumn>
        <addForeignKeyConstraint
                baseTableName="catalog"
                baseColumnNames="category_id"
                referencedTableName="category"
                referencedColumnNames="id"
                constraintName="fk_catalog_category"/>
    </changeSet>

</databaseChangeLog>
